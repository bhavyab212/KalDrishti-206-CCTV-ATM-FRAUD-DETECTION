# On-Premise Deployment Configuration (Air-Gapped / Private LAN Only)
APP_ENV=on_premise
API_HOST=0.0.0.0
API_PORT=8000

# Security & Auth (Change before deployment)
JWT_SECRET_KEY=replace_with_256bit_local_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
MFA_ENABLED=true

# PostgreSQL 16 + pgvector 0.8+
DATABASE_URL=postgresql://forensic_user:change_me_local@postgres:5432/atm_forensics
PGVECTOR_ITERATIVE_SCAN=relaxed_order

# Redis + Celery GPU Queue
REDIS_URL=redis://redis:6379/0
CELERY_GPU_CONCURRENCY=1

# Storage Paths (WORM Read-Only Raw vs Derived Evidence)
WORM_STORAGE_DIR=/data/worm_raw_clips
DERIVED_STORAGE_DIR=/data/derived_evidence
EXPORT_STORAGE_DIR=/data/court_bundles
TEMP_SCRATCH_DIR=/tmp/atm_forensics_scratch

# Precision & Forensic Rules
DETECTION_PRECISION=fp16
RESTORATION_PRECISION=fp32
BIOMETRIC_PRECISION=fp32
MAX_FUSION_POSE_VARIANCE_DEG=5.0
